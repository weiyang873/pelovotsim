    "sub_lift": "unitless_index"
  },
  "definitions": {
    "dCOGS": "Per-unit incremental cost vs LOVOT baseline; may include hardware BOM delta plus amortized software/algorithm cost. Negative values represent cost-down moves.",
    "risk": "Implementation/quality risk index (0-1). Higher means higher probability of defects, reliability issues, compliance or operational risk.",
    "sub_lift": "Subscription pull index. Higher means stronger likelihood to attach/retain subscription (or willingness to pay for recurring services). Negative means subscription demand may drop."
  },
