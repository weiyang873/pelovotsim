{
  "name": "emba-ai-sim-v01",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "build-client": "npm --prefix client run build",
    "dev-client": "npm --prefix client run dev",
    "preview-client": "npm --prefix client run preview",
    "test:e2e": "npx playwright test",
    "test:e2e:r1": "npx playwright test round1-full-flow",
    "test:e2e:r2": "npx playwright test round2-full-flow",
    "test:e2e:full": "npx playwright test full-simulation",
    "test:e2e:live": "TEST_URL=https://app.praxisengine.xyz npx playwright test",
    "test:e2e:local": "TEST_URL=http://localhost:3000 npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:report": "npx playwright show-report"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "archiver": "^7.0.1",
    "json2csv": "^6.0.0-alpha.2",
    "nodejieba": "3.5.7",
    "pg": "^8.20.0",
    "undici": "^7.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2"
  }
}
