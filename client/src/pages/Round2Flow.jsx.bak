  {id:"cloud_update",n:"云端智更新",tg:"OTA更新",b:[60,120,200],r:[.08,.1,.12],l:[2,3,4],s:[.03,.06,.08],d:[]},
  {id:"remote_diagnostics",n:"远程诊断",tg:"OTA更新",b:[40,90,140],r:[.06,.07,.08],l:[1,2,3],s:[.01,.02,.03],d:[]},
  {id:"qa_system",n:"质量体系",tg:"降风险",b:[40,90,140],r:[-.03,-.06,-.1],l:[0,0,0],s:[0,.01,.02],rd:1,d:[]},
  {id:"cost_engineering",n:"成本工程",tg:"降本",b:[-60,-120,-200],r:[.05,.06,.08],l:[0,0,0],s:[0,0,0],cd:1,d:[]},
  {id:"sla_support",n:"客服/SLA",tg:"降风险",b:[40,90,140],r:[-.02,-.04,-.06],l:[0,0,0],s:[.01,.02,.03],rd:1,d:[]},
],
};
const ALL = Object.values(CC).flat();
const fc = (id) => ALL.find((c) => c.id === id);
const TI = {low:0,mid:1,high:2};
const TS = ["low","mid","high"];
const TL = {low:"基础",mid:"标准",high:"旗舰"};
const R1 = {gm:.553,P:12800,cogs:4200};
const CAPMAX = 24;
const STEPS = ["R1回顾","维度分配","焦点访谈","个人选卡","团队合并","集体讨论","最终结果"];
const OTHER = {
  1:{perception_base:"mid",scene_triggers:"mid",basic_avoidance:"mid",auto_dock_charge:"mid"},
  2:{connect_base:"mid",mobile_app:"mid",cloud_update:"mid",remote_diagnostics:"mid",cost_engineering:"mid"},
  3:{emotion_recognition:"high",perception_base:"high",persona_dialog:"mid",expressive_style_pack:"mid"},
};

const doCalc = (s) => {
  let c=0,l=0,r=0,sb=0,n=0;
  Object.entries(s).forEach(([id,t]) => {
    const cd = fc(id); if(!cd) return;
    const i = TI[t]; c+=cd.b[i]; l+=cd.l[i]; r+=cd.r[i]; sb+=cd.s[i]; n++;
  });
  return {cost:c,ld:l,rk:r,sb,cnt:n,gm:R1.gm-c/R1.P};
};

const doViols = (s,ph) => {
  const vs = []; const seen = {};
  Object.entries(s).forEach(([id,tier]) => {
    const c = fc(id); if(!c) return;
    c.d.forEach((dep) => {
      const app = dep.t===tier||(dep.r==="exc"&&TS.indexOf(dep.t)<=TS.indexOf(tier));
      if(!app) return;
      if(dep.x && ph==="ind") return;
      const key = [id,dep.cap].sort().join("-")+dep.r;
      if(seen[key]) return; seen[key]=true;
      const tn = fc(dep.cap); const tname = tn?tn.n:dep.cap;
      if(dep.r==="req"){
        const h=s[dep.cap];
        if(!h) vs.push(c.n+"("+tier+") → "+tname+"≥"+dep.mt+(dep.x?" [跨维度]":""));
        else if(TI[h]<TI[dep.mt]) vs.push(c.n+" → "+tname+"≥"+dep.mt+", 当前 "+h);
      }
      if(dep.r==="exc"&&s[dep.cap]) vs.push(c.n+" ✕ "+tname);
    });
  });
  return vs;
};

function RadarChart({ scores, memberDims }) {
  const dims = [
    { id: "perception", label: "感知", angle: -90, color: "#7C3AED" },
    { id: "motion", label: "运动", angle: -30, color: "#0891B2" },
    { id: "interaction", label: "交互", angle: 30, color: "#D97706" },
    { id: "safety", label: "安全", angle: 90, color: "#DC2626" },
    { id: "extend", label: "连接", angle: 150, color: "#059669" },
    { id: "ops", label: "运维", angle: 210, color: "#4F46E5" }
  ];
  const cx = 140;
  const cy = 140;
  const maxR = 110;
  const maxVal = 10;
  const mine = Array.isArray(memberDims) ? memberDims : [];

  const toXY = (angle, r) => ({
    x: cx + r * Math.cos((angle * Math.PI) / 180),
    y: cy + r * Math.sin((angle * Math.PI) / 180)
  });

  const rings = [3, 6, 9].map((v) => {
    const r = (v / maxVal) * maxR;
    return dims.map((d) => toXY(d.angle, r)).map((p) => `${p.x},${p.y}`).join(" ");
  });

  const normalized = {
    perception: Number(scores?.perception || 0),
    motion: Number(scores?.motion || scores?.mobility || 0),
    interaction: Number(scores?.interaction || 0),
    safety: Number(scores?.safety || scores?.safety_privacy || 0),
    extend: Number(scores?.extend || scores?.integration || 0),
    ops: Number(scores?.ops || scores?.operations || 0)
  };
  const dataPts = dims.map((d) => toXY(d.angle, (Math.max(0, Math.min(10, normalized[d.id])) / maxVal) * maxR));
  const dataPath = dataPts.map((p) => `${p.x},${p.y}`).join(" ");

  return (
    <svg width={280} height={280} style={{ display: "block", margin: "10px auto 12px" }}>
      {rings.map((pts, i) => (
        <polygon key={`ring-${i}`} points={pts} fill="none" stroke="#e5e7eb" strokeWidth={1} strokeDasharray="4,4" />
      ))}
      {dims.map((d) => {
        const p = toXY(d.angle, maxR);
        return <line key={`axis-${d.id}`} x1={cx} y1={cy} x2={p.x} y2={p.y} stroke="#e5e7eb" strokeWidth={1} />;
      })}
      {[3, 6, 9].map((v) => (
        <text key={`tick-${v}`} x={cx + 4} y={cy - (v / maxVal) * maxR + 1} style={{ fontSize: 9, fill: "#9ca3af" }}>
          {v}
        </text>
      ))}
      <polygon points={dataPath} fill="rgba(47,171,110,0.25)" stroke="#2FAB6E" strokeWidth={2} />
      {dims.map((d) => {
        const val = Math.max(0, Math.min(10, normalized[d.id]));
        const p = toXY(d.angle, (val / maxVal) * maxR);
        const lp = toXY(d.angle, maxR + 22);
        const isMine = mine.includes(d.id);
        return (
          <g key={`point-${d.id}`}>
            <circle cx={p.x} cy={p.y} r={4} fill="#2FAB6E" />
            <text
              x={lp.x}
              y={lp.y}
              textAnchor="middle"
              dominantBaseline="middle"
              style={{ fontSize: 11, fontWeight: isMine ? 800 : 500, fill: isMine ? d.color : "#9ca3af" }}
            >
              {`${d.label} ${val.toFixed(1)}`}
            </text>
          </g>
        );
      })}
    </svg>
  );
}

export default function Round2Flow() {
  const [step, setStep] = useState(0);
  const [am, setAm] = useState(0);
  const [sel, setSel] = useState({});
  const [teamDraft, setTeamDraft] = useState({});
  const [recap, setRecap] = useState(null);
  const [assignments, setAssignments] = useState(ASGN.map((a, i) => ({ memberId: `mock-${i}`, memberName: MN[i], dims: a.dims, personas: a.ps })));
  const [memberMeta, setMemberMeta] = useState({ teamId: "", memberId: "" });
  const [interviewData, setInterviewData] = useState(null);
  const [mergedInterview, setMergedInterview] = useState(null);
  const [cardsByDim, setCardsByDim] = useState(CC);
  const [selectedBy, setSelectedBy] = useState({});
  const [validationRes, setValidationRes] = useState({ violations: [], hardViolationCount: 0, soft: null });
  const [preview, setPreview] = useState(null);
  const [pricePreview, setPricePreview] = useState(null);
  const [finalResult, setFinalResult] = useState(null);
  const [reflection, setReflection] = useState("");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState("");
  const [price, setPrice] = useState(0);

  const mapGroupToDim = {
    interaction_expression: "interaction",
    perception_understanding: "perception",
    mobility_navigation: "motion",
    safety_trust: "safety",
    expand_connect: "extend",
    ops_maintenance: "ops"
  };

  const allCards = useMemo(() => Object.values(cardsByDim || {}).flat(), [cardsByDim]);
  const fcLocal = useCallback((id) => allCards.find((c) => c.id === id), [allCards]);

  const doCalcNow = useCallback((source) => {
    let cost = 0;
    let ld = 0;
    let rk = 0;
    let sb = 0;
    let cnt = 0;
    Object.entries(source || {}).forEach(([id, tier]) => {
      const card = fcLocal(id);
      if (!card || TI[tier] == null) return;
      const i = TI[tier];
      cost += Number(card.b?.[i] || 0);
      ld += Number(card.l?.[i] || 0);
      rk += Number(card.r?.[i] || 0);
      sb += Number(card.s?.[i] || 0);
      cnt += 1;
    });
    const P = Number(recap?.P || R1.P || 12800);
    const gmBase = Number(recap?.target_gm || R1.gm || 0.553);
    return { cost, ld, rk, sb, cnt, gm: gmBase - cost / Math.max(P, 1) };
  }, [fcLocal, recap]);

  const doViolsNow = useCallback((source, phase) => {
    const vs = [];
    const seen = {};
    Object.entries(source || {}).forEach(([id, tier]) => {
      const c = fcLocal(id);
      if (!c) return;
      (c.d || []).forEach((dep) => {
        const app = dep.t === tier || (dep.r === "exc" && TS.indexOf(dep.t) <= TS.indexOf(tier));
        if (!app) return;
        if (dep.x && phase === "ind") return;
        const key = [id, dep.cap].sort().join("-") + dep.r;
        if (seen[key]) return;
        seen[key] = true;
        const tn = fcLocal(dep.cap);
        const tname = tn ? tn.n : dep.cap;
        if (dep.r === "req") {
          const h = source[dep.cap];
          if (!h) vs.push(`${c.n}(${tier}) → ${tname}≥${dep.mt}${dep.x ? " [跨维度]" : ""}`);
          else if (TI[h] < TI[dep.mt]) vs.push(`${c.n} → ${tname}≥${dep.mt}, 当前 ${h}`);
        }
        if (dep.r === "exc" && source[dep.cap]) vs.push(`${c.n} ✕ ${tname}`);
      });
    });
    return vs;
  }, [fcLocal]);

  const ph = step <= 3 ? "ind" : "team";
  const myA = assignments[am] || assignments[0] || { memberId: "", memberName: "成员", dims: ["interaction", "safety"], personas: "访谈对象" };
  const isSingleTeam = assignments.length === 1;

  const teamSel = useMemo(() => {
    if (step < 4) return sel;
    if (Object.keys(teamDraft).length > 0) return teamDraft;
    const m = { ...sel };
    Object.entries(OTHER).forEach(([mi, cards]) => {
      if (parseInt(mi, 10) !== am) {
        Object.entries(cards).forEach(([cid, t]) => {
          if (!m[cid]) m[cid] = t;
        });
      }
    });
    return m;
  }, [sel, am, step, teamDraft]);

  const draftSource = step >= 5 ? teamSel : sel;
  const tot = useMemo(() => doCalcNow(sel), [sel, doCalcNow]);
  const tTot = useMemo(() => doCalcNow(teamSel), [teamSel, doCalcNow]);
  const localV = useMemo(() => doViolsNow(sel, "ind"), [sel, doViolsNow]);
  const localTeamV = useMemo(() => doViolsNow(teamSel, "team"), [teamSel, doViolsNow]);

  const pmaxBase = Number(recap?.Pmax || 14200);
  const rdBenchmark = Math.round(pmaxBase * 0.20);
  const capMax = Number(validationRes.soft?.capacity?.capacityCap || CAPMAX);
  const liveViolations = step >= 4 ? (validationRes.violations || localTeamV) : localV;
  const liveHardCount = Number(validationRes.hardViolationCount || 0);

  useEffect(() => {
    const url = new URL(window.location.href);
    const teamId = url.searchParams.get("teamId") || "";
    const memberId = url.searchParams.get("memberId") || "";
    setMemberMeta({ teamId, memberId });
  }, []);

  useEffect(() => {
    if (!memberMeta.teamId) return;
    getRound2Recap(memberMeta.teamId)
      .then((data) => {
        setRecap(data);
        const wtp = Number(data?.WTP || data?.Pmax || 0);
        const pmax = Number(data?.Pmax || 0);
        const init = Math.round(wtp * 0.85);
        const lo = Math.max(1, Math.round(wtp * 0.5));
        const hi = Math.max(lo, Math.round(pmax || lo));
        setPrice(Math.min(Math.max(init, lo), hi));
      })
      .catch(() => setRecap(null));
  }, [memberMeta.teamId]);

  useEffect(() => {
    if (!memberMeta.teamId) return;
    assignRound2Dimensions({ teamId: memberMeta.teamId })
      .then((res) => {
        const rows = (res.assignments || []).map((x, idx) => ({
          memberId: x.memberId,
          memberName: x.memberName || MN[idx] || `成员${idx + 1}`,
          dims: x.dims || [],
          personas: x.personas || ""
        }));
        if (rows.length) setAssignments(rows);
      })
      .catch(() => {});
  }, [memberMeta.teamId]);

  useEffect(() => {
    if (!memberMeta.memberId || !assignments.length) return;
    const idx = assignments.findIndex((x) => x.memberId === memberMeta.memberId);
    if (idx >= 0) setAm(idx);
  }, [memberMeta.memberId, assignments]);

  useEffect(() => {
    getRdCards()
      .then((res) => {
        const next = {};
        (res.groups || []).forEach((g) => {
          const dimId = mapGroupToDim[g.group_id];
          if (!dimId) return;
          next[dimId] = (g.capabilities || []).map((c) => {
            const mkDep = [];
            TS.forEach((tier) => {
              const td = c.tiers?.[tier] || {};
              (td.requires || []).forEach((req) => {
                if (req?.cap) mkDep.push(mk(tier, "req", req.cap, req.min_tier || "low", req.type !== "hard"));
              });
              (td.excludes || []).forEach((exc) => {
                if (!exc?.cap) return;
                if (exc.any_tier) {
                  TS.forEach((t2) => mkDep.push(mk(t2, "exc", exc.cap, null, exc.type !== "hard")));
                } else if (Array.isArray(exc.tier_in) && exc.tier_in.length) {
                  exc.tier_in.forEach((t2) => mkDep.push(mk(t2, "exc", exc.cap, null, exc.type !== "hard")));
                } else {
                  mkDep.push(mk(tier, "exc", exc.cap, null, exc.type !== "hard"));
                }
              });
            });
            return {
              id: c.cap_id,
              n: c.name,
              tg: (c.covers || []).join("，"),
              b: TS.map((t) => Number(c.tiers?.[t]?.dCOGS || 0)),
              r: TS.map((t) => Number(c.tiers?.[t]?.risk || 0)),
              l: TS.map((t) => Number(c.tiers?.[t]?.load || 0)),
              s: TS.map((t) => Number(c.tiers?.[t]?.sub_lift || 0)),
              cd: TS.every((t) => Number(c.tiers?.[t]?.dCOGS || 0) <= 0) ? 1 : 0,
              rd: TS.some((t) => Number(c.tiers?.[t]?.risk || 0) < 0) ? 1 : 0,
              d: mkDep
            };
          });
        });
        if (Object.keys(next).length) setCardsByDim((prev) => ({ ...prev, ...next }));
      })
      .catch(() => {});
  }, []);

  const toSelections = useCallback((source) => Object.entries(source || {}).map(([cap_id, tier]) => ({ cap_id, tier })), []);

  const calcPayload = useCallback((source) => {
    const iv = (step >= 4 && mergedInterview) ? mergedInterview : (interviewData || {});
    const radar = iv.radar || { perception: 6, mobility: 6, interaction: 6, safety_privacy: 6, integration: 5, operations: 5 };
    const tags = iv.tags || [];
    const evi = Number(iv.evi || 0.7);
    return {
      gridId: recap?.final_grid_id || "B2B_Differentiation_Experience",
      radar,
      tags,
      evi,
      priceSensitive: Boolean(recap?.priceSensitive || false),
      selections: toSelections(source),
      P: Number(price || recap?.P || 12800),
      WTP: Number(recap?.WTP || recap?.Pmax || 14200),
      e: Number(recap?.e || 1.2),
      Pmax: Number(recap?.Pmax || 14200),
      f: Number(recap?.f || 0.124),
      COGSbase: Number(recap?.COGSbase || 4200),
      TAM: Number(recap?.TAM || 50000),
      H: Number(recap?.H || 0.3)
    };
  }, [step, mergedInterview, interviewData, recap, toSelections, price]);

  const refreshValidationAndPreview = useCallback(async (source, finalMode = false) => {
    const selections = toSelections(source);
    try {
      const v = await validateRd({ selections, COGSbase: Number(recap?.COGSbase || 4200) });
      setValidationRes({
        violations: v.violations || [],
        hardViolationCount: Number(v.hardViolationCount || 0),
        soft: v.soft || null
      });
      const c = await calculateRd(calcPayload(source));
      if (finalMode) setFinalResult(c);
      else setPreview(c);
      return c;
    } catch (e) {
      if (finalMode) setFinalResult(null);
      setError(e.message || "计算失败");
      return null;
    }
  }, [calcPayload, recap, toSelections]);

  useEffect(() => {
    if (!memberMeta.teamId || !memberMeta.memberId || step !== 3) return;
    const payload = toSelections(sel);
    saveRound2MemberSelection({ teamId: memberMeta.teamId, memberId: memberMeta.memberId, selections: payload }).catch(() => {});
    refreshValidationAndPreview(sel, false).catch(() => {});
  }, [sel, memberMeta.teamId, memberMeta.memberId, step, toSelections, refreshValidationAndPreview]);

  useEffect(() => {
    if (step < 5) return;
    refreshValidationAndPreview(teamSel, false).catch(() => {});
  }, [step, teamSel, refreshValidationAndPreview]);

  useEffect(() => {
    if (!recap || !(step === 3 || step === 5)) return;
    const source = step === 3 ? sel : teamSel;
    const calc = preview || finalResult;
    if (!calc) return;
    const payload = {
      P: Number(price || 0),
      WTP: Number(recap.WTP || recap.Pmax || 1),
      e: Number(recap.e || 1.2),
      V: Number(calc.V || 0),
      COGSbase: Number(recap.COGSbase || 0),
      dCOGS: Number(calc.dCOGS || 0),
      f: Number(recap.f || 0),
      TAM: Number(recap.TAM || 0),
      H: Number(recap.H || 0),
      Pmax: Number(recap.Pmax || 0),
      S_competitive: Number(calc.S_competitive || 0),
      R: Number(calc.R != null ? calc.R : 1)
    };
    previewRdPrice(payload).then((out) => setPricePreview(out)).catch(() => {});
  }, [price, recap, step, sel, teamSel, preview, finalResult]);

  useEffect(() => {
    if (step === 4 && isSingleTeam) setStep(5);
  }, [step, isSingleTeam]);

  const setDraftValue = useCallback((updater) => {
    if (step >= 5) {
      setTeamDraft((p) => {
        const base = Object.keys(p || {}).length > 0 ? p : teamSel;
        return updater({ ...base });
      });
    } else {
      setSel((p) => updater({ ...p }));
    }
  }, [step, teamSel]);

  const tog = useCallback((id) => {
    setDraftValue((n) => {
      if (n[id]) delete n[id];
      else n[id] = "mid";
      return n;
    });
  }, [setDraftValue]);

  const stier = useCallback((id, t) => {
    setDraftValue((n) => {
      if (n[id]) n[id] = t;
      return n;
    });
  }, [setDraftValue]);

  const renderMetrics = (t, v, calc) => {
    const netCost = Number(t.cost || 0);
    const positive = Number(validationRes.soft?.budget?.positiveDCOGS ?? Math.max(0, netCost));
    const costDown = Math.max(0, positive - netCost);
    const benchmark = Math.max(1, Number(calc?.budgetBenchmark ?? rdBenchmark ?? 0));
    const dCOGS = Number(calc?.dCOGS ?? netCost);
    const penalty = Number(calc?.penalty || 0);
    const overBenchmark = dCOGS > benchmark;
    const targetGm = Number(recap?.target_gm || R1.gm || 0.553);
    const pmax = Math.max(1, Number(recap?.Pmax || 14200));
    const actualGm = targetGm - netCost / pmax;
    const gmDeltaPct = Math.abs((netCost / pmax) * 100);
    const loadVal = Number(validationRes.soft?.capacity?.totalLoad ?? t.ld);
    const capCap = Number(validationRes.soft?.capacity?.capacityCap || capMax || 24);
    const overC = loadVal > capCap;
    return (
      <div style={{ display: "flex", gap: 6, flexWrap: "wrap", marginBottom: 8 }}>
        <div style={{ flex: "1 1 220px", padding: "6px 10px", borderRadius: 6, background: overBenchmark ? "#FEF2F2" : "#F0FDF4", border: overBenchmark ? "1px solid #FECACA" : "1px solid #BBF7D0" }}>
          <div style={{ fontSize: 11, display: "flex", justifyContent: "space-between" }}>
            <b style={{ color: overBenchmark ? "#991B1B" : "#166534" }}>{overBenchmark ? "⚠ 超出基准" : "✓ 基准内"}</b>
            <span>净增量 <b>{netCost > 0 ? "+" : ""}{Math.round(netCost)}</b> / 基准 {Math.round(benchmark)}</span>
          </div>
          <div style={{ width: "100%", height: 5, borderRadius: 3, background: "#e5e7eb", marginTop: 2 }}>
            <div style={{ width: `${Math.min((Math.max(netCost, 0) / benchmark) * 100, 100)}%`, height: "100%", borderRadius: 3, background: overBenchmark ? "#EF4444" : "#2FAB6E" }} />
          </div>
          <div style={{ fontSize: 10, marginTop: 3, color: "#334155", display: "flex", alignItems: "center", gap: 6, flexWrap: "wrap" }}>
            {costDown > 0 && <span style={{ color: "#16a34a" }}>（含降本 -{Math.round(costDown)}）</span>}
            {overBenchmark && penalty > 0 && <span style={{ color: "#b91c1c" }}>超预算惩罚 -{Math.round(penalty).toLocaleString()}</span>}
            <span>毛利 <b style={{ color: actualGm < 0.2 ? "#DC2626" : "#166534" }}>{(actualGm * 100).toFixed(1)}%</b></span>
            <span style={{ color: "#9ca3af" }}>（target {(targetGm * 100).toFixed(1)}%，{netCost > 0 ? "↓" : "↑"}{gmDeltaPct.toFixed(1)}%）</span>
          </div>
        </div>
        <div style={{ flex: "1 1 120px", padding: "6px 10px", borderRadius: 6, background: overC ? "#FEF2F2" : "#F9FAFB", border: overC ? "1px solid #FECACA" : "1px solid #e5e7eb" }}>
          <div style={{ fontSize: 11 }}><b>系统负载</b> {Math.round(loadVal)}/{capCap}</div>
          <div style={{ width: "100%", height: 5, borderRadius: 3, background: "#e5e7eb", marginTop: 2 }}>
            <div style={{ width: `${Math.min((loadVal / Math.max(1, capCap)) * 100, 100)}%`, height: "100%", borderRadius: 3, background: overC ? "#EF4444" : "#0891B2" }} />
          </div>
        </div>
        <div style={{ flex: "0 0 auto", padding: "6px 10px", borderRadius: 6, background: "#F9FAFB", border: "1px solid #e5e7eb", fontSize: 11 }}>
          已选 {t.cnt}/8-10 | 依赖问题 {v.length}
        </div>
      </div>
    );
  };

  const renderPricePanel = () => {
    const wtp = Number(recap?.WTP || recap?.Pmax || 1);
    const pmax = Math.max(1, Number(recap?.Pmax || wtp));
    const lo = Math.max(1, Math.round(wtp * 0.5));
    const hi = Math.max(lo, Math.round(pmax));
    const current = Math.min(Math.max(Number(price || lo), lo), hi);
    const pOut = pricePreview || {};
    const adoption = Number(pOut.adoption || 0);
    const share = Number(pOut.share || 0);
    const units = Number(pOut.units || 0);
    const profit = Number(pOut.profit || 0);
    const wtpPrime = Number(pOut.wtpPrime || preview?.wtpPrime || finalResult?.wtpPrime || 0);
    return (
      <div style={{ background: "#fff", border: "1px solid #e5e7eb", borderRadius: 10, padding: "10px 12px", marginBottom: 8 }}>
        <div style={{ fontSize: 12, fontWeight: 700, marginBottom: 6 }}>定价模拟</div>
        <div style={{ fontSize: 11, color: "#64748b", marginBottom: 4 }}>P = {current.toLocaleString()}（范围 {lo.toLocaleString()} - {hi.toLocaleString()}）</div>
        <input type="range" min={lo} max={hi} step={10} value={current} onChange={(e) => setPrice(Number(e.target.value))} style={{ width: "100%" }} />
        <div style={{ fontSize: 10, color: "#64748b", marginTop: 4 }}>WTP' {Math.round(wtpPrime || wtp).toLocaleString()} ｜ adoption {(adoption * 100).toFixed(1)}% ｜ share {(share * 100).toFixed(1)}% ｜ units {units.toLocaleString()} ｜ profit {Math.round(profit).toLocaleString()}</div>
      </div>
    );
  };

  const renderCard = (card, dim, sels, showCross) => {
    const isOn = !!sels[card.id];
    const tier = sels[card.id] || "mid";
    const ti = TI[tier];
    const rawBom = Number(card.b?.[ti] || 0);
    const rawRisk = Number(card.r?.[ti] || 0);
    const load = Number(card.l?.[ti] || 0);
    const jin = JIN[card.id] || (recap?.jinang_tech?.match_strength ? `${recap.jinang_tech.card_id}-${Math.round(recap.jinang_tech.match_strength * 100)}%` : "");
    const discount = recap?.jinang_tech?.match_strength && /(voice|dialog|cloud|remote)/i.test(card.id) ? Number(recap.jinang_tech.match_strength) * 0.2 : 0;
    const bom = Math.round(rawBom * (1 - discount));
    const risk = Math.max(0, rawRisk - discount * 0.1);
    const rC = risk < 0.01 ? "#2FAB6E" : risk < 0.08 ? "#2FAB6E" : risk < 0.15 ? "#D4A03C" : "#EF4444";
    const rL = risk < 0.01 ? "低" : risk < 0.08 ? "低" : risk < 0.15 ? "中" : "高";
    const bC = bom < 0 ? "#2FAB6E" : bom > 200 ? "#DC2626" : "#374151";
    const owners = selectedBy[card.id] || [];

    const xdeps = isOn ? (card.d || []).filter((dd) => dd.x && (dd.t === tier || (dd.r === "exc" && TS.indexOf(dd.t) <= TS.indexOf(tier)))) : [];
    const sdeps = isOn ? (card.d || []).filter((dd) => !dd.x && (dd.t === tier || (dd.r === "exc" && TS.indexOf(dd.t) <= TS.indexOf(tier)))) : [];

    return (
      <div key={card.id} style={{ padding: "10px 12px", borderRadius: 10, position: "relative", border: isOn ? (`2px solid ${card.cd ? "#2FAB6E" : dim.c}`) : "1.5px solid #e5e7eb", background: card.cd ? "#fafff8" : "#fff" }}>
        {card.cd && <div style={{ position: "absolute", top: 4, right: 6, fontSize: 9, fontWeight: 700, padding: "1px 5px", borderRadius: 3, background: "#DCFCE7", color: "#166534" }}>降本</div>}
        {card.rd && <div style={{ position: "absolute", top: 4, right: 6, fontSize: 9, fontWeight: 700, padding: "1px 5px", borderRadius: 3, background: "#DBEAFE", color: "#1E40AF" }}>降险</div>}
        {jin && <div style={{ position: "absolute", top: (card.cd || card.rd) ? 20 : 4, right: 6, fontSize: 8, padding: "1px 4px", borderRadius: 3, background: "#FEF3C7", color: "#92400E", border: "1px solid #FDE68A" }}>{jin}</div>}
        {owners.length > 0 && <div style={{ position: "absolute", top: (card.cd || card.rd) ? 36 : 20, right: 6, fontSize: 8, color: "#475569" }}>{owners.join("、")}</div>}

        <div style={{ display: "flex", gap: 5, marginBottom: 4, paddingRight: 90 }}>
          <input type="checkbox" checked={isOn} onChange={() => tog(card.id)} style={{ width: 14, height: 14, marginTop: 1, cursor: "pointer" }} />
          <div>
            <div style={{ fontSize: 13, fontWeight: 700, lineHeight: 1.2 }}>{card.n}</div>
            <div style={{ fontSize: 9, color: "#9ca3af" }}>{card.tg}</div>
          </div>
        </div>

        <div style={{ marginLeft: 19, display: "flex", gap: 5, flexWrap: "wrap", marginBottom: 4, alignItems: "center" }}>
          <span style={{ fontSize: 11, fontWeight: 700, color: bC }}>{bom > 0 ? "+" : ""}{bom}</span>
          <span style={{ fontSize: 9, fontWeight: 700, padding: "1px 4px", borderRadius: 3, background: `${rC}18`, color: rC }}>风险-{rL}</span>
          <span style={{ fontSize: 10, color: load >= 4 ? "#D97706" : "#6b7280" }}>负载 {load}</span>
        </div>

        <div style={{ marginLeft: 19, display: "flex", gap: 4 }}>
          {TS.map((tt) => {
            const active = tier === tt && isOn;
            const ac = card.cd ? "#2FAB6E" : dim.c;
            return (
              <button key={tt} onClick={() => { if (isOn) stier(card.id, tt); }} style={{
                padding: "2px 10px", borderRadius: 4, fontSize: 10, fontWeight: 600, cursor: isOn ? "pointer" : "default",
                border: active ? (`2px solid ${ac}`) : "1px solid #d1d5db",
                background: active ? `${ac}10` : "#fff",
                color: active ? ac : "#aaa", opacity: isOn ? 1 : 0.4
              }}>
                {TL[tt]}({Number(card.b?.[TI[tt]] || 0) > 0 ? "+" : ""}{Number(card.b?.[TI[tt]] || 0)})
              </button>
            );
          })}
        </div>

        {showCross && xdeps.length > 0 && (
          <div style={{ marginTop: 4, marginLeft: 19, padding: "3px 6px", borderRadius: 4, background: "#EFF6FF", border: "1px solid #BFDBFE" }}>
            {xdeps.map((dd, i) => {
              const tn = fcLocal(dd.cap);
              return (
                <div key={i} style={{ fontSize: 10, color: "#1E40AF" }}>
                  {"→ "}{dd.r === "req" ? (`需要 ${tn ? tn.n : dd.cap}≥${dd.mt}`) : (`✕ ${tn ? tn.n : dd.cap}`)} [其他成员负责]
                </div>
              );
            })}
          </div>
        )}

        {sdeps.map((dd, i) => {
          const tn = fcLocal(dd.cap);
          const tname = tn ? tn.n : dd.cap;
          const sat = dd.r === "req" ? (sels[dd.cap] && TI[sels[dd.cap]] >= TI[dd.mt]) : !sels[dd.cap];
          return (
            <div key={i} style={{ marginTop: 2, marginLeft: 19, fontSize: 10, color: sat ? "#2FAB6E" : "#DC2626" }}>
              {dd.r === "req" ? (`→ 需要 ${tname}≥${dd.mt}`) : (`✕ ${tname}`)} {sat ? "✓" : "!!"}
            </div>
          );
        })}
      </div>
    );
  };

  const renderDimGroup = (dimId, sels, showCross) => {
    const dim = DIMS.find((d) => d.id === dimId);
    const cards = cardsByDim[dimId] || [];
    const cnt = cards.filter((c) => !!sels[c.id]).length;
    const radarSource = (step >= 4 && mergedInterview?.radar) ? mergedInterview.radar : interviewData?.radar;
    const radarValue = radarSource
      ? (dimId === "motion"
          ? radarSource.mobility
          : dimId === "extend"
            ? radarSource.integration
            : dimId === "ops"
              ? radarSource.operations
              : dimId === "safety"
                ? radarSource.safety_privacy
                : radarSource[dimId])
      : RDR[dimId];
    return (
      <div key={dimId} style={{ marginBottom: 4 }}>
        <div style={{ display: "flex", justifyContent: "space-between", padding: "7px 14px", background: `${dim.c}12`, borderBottom: `3px solid ${dim.c}` }}>
          <span style={{ fontSize: 14, fontWeight: 800 }}>{dim.icon} {dim.l}</span>
          <span style={{ fontSize: 12, fontWeight: 700, color: dim.c }}>雷达{radarValue} | {cnt}/1-3</span>
        </div>
        <div style={{ display: "grid", gap: 6, padding: 8, gridTemplateColumns: "repeat(auto-fill,minmax(280px,1fr))", background: "#fff", border: `1px solid ${dim.c}15`, borderTop: "none" }}>
          {cards.map((card) => renderCard(card, dim, sels, showCross))}
        </div>
      </div>
    );
  };

  const runMerge = async () => {
    if (!memberMeta.teamId) return;
    try {
      setBusy(true);
      const out = await mergeRound2Selections({ teamId: memberMeta.teamId, COGSbase: Number(recap?.COGSbase || 4200) });
      const next = {};
      const ownerMap = {};
      (out.teamSelections || []).forEach((s) => {
        next[s.cap_id] = s.tier;
        ownerMap[s.cap_id] = s.selectedBy || [];
      });
      setSelectedBy(ownerMap);
      setTeamDraft(next);
      setValidationRes({
        violations: out.violations || [],
        hardViolationCount: Number(out.hardViolationCount || 0),
        soft: out.softPenalties || null
      });
      if (out.mergedInterview) {
        setMergedInterview(out.mergedInterview);
      }
    } catch (e) {
      setError(e.message || "团队合并失败");
    } finally {
      setBusy(false);
    }
  };

  const runInterviewAuto = async () => {
    if (!memberMeta.teamId || !myA.memberId) return;
    try {
      setBusy(true);
      const out = await round2InterviewAuto({
        teamId: memberMeta.teamId,
        memberId: myA.memberId,
        memberDims: myA.dims
      });
      setInterviewData({
        sessionId: out.sessionId,
        personas: out.personas || [],
        transcript: out.transcript || [],
        radar: out.radar || null,
        tags: out.tags || [],
        evi: out.evi || 0.7
      });
      setMergedInterview(null);
    } catch (e) {
      setError(e.message || "访谈生成失败");
    } finally {
      setBusy(false);
    }
  };

  const finalizeRound2 = async () => {
    const r = await refreshValidationAndPreview(teamSel, true);
    if (!r) return;
    setStep(6);
    if (memberMeta.teamId) {
      getRound2Reflection({ teamId: memberMeta.teamId, calcResult: r })
        .then((x) => setReflection(x.report || ""))
        .catch(() => {});
    }
  };

  const BS = { marginTop: 10, width: "100%", padding: "10px", borderRadius: 10, background: "#1a5c3a", color: "#fff", border: "none", fontSize: 14, fontWeight: 700, cursor: "pointer" };

  const result = finalResult || preview || {};

  return (
    <div style={{ fontFamily: "'Noto Sans SC',-apple-system,sans-serif", background: "#fafaf8", minHeight: "100vh", padding: "14px 12px" }}>
      <div style={{ maxWidth: 1060, margin: "0 auto" }}>
        <h1 style={{ fontSize: 18, fontWeight: 800, margin: "0 0 2px" }}>Round 2 - 用户访谈 + 研发选卡</h1>
        {error && <div style={{ marginTop: 8, fontSize: 12, color: "#b91c1c" }}>⚠ {error}</div>}

        <div style={{ display: "flex", alignItems: "center", margin: "8px 0 16px" }}>
          {STEPS.map((s, i) => (
            <div key={i} style={{ display: "flex", alignItems: "center", flex: i < 6 ? 1 : "none" }}>
              <div onClick={() => setStep(i)} style={{
                width: 28, height: 28, borderRadius: "50%", display: "flex", alignItems: "center", justifyContent: "center",
                fontSize: 11, fontWeight: 700, cursor: "pointer",
                background: i <= step ? "#1a5c3a" : "#e5e7eb", color: i <= step ? "#fff" : "#aaa",
                boxShadow: i === step ? "0 0 0 3px #1a5c3a33" : "none"
              }}>{i + 1}</div>
              {i < 6 && <div style={{ flex: 1, height: 2, margin: "0 2px", background: i < step ? "#1a5c3a" : "#e5e7eb" }} />}
            </div>
          ))}
          <span style={{ marginLeft: 8, fontSize: 11, fontWeight: 600, color: "#6b7280" }}>{STEPS[step]}</span>
        </div>

        {step === 0 && (
          <div style={{ background: "#fff", borderRadius: 14, padding: 20, border: "1px solid #e5e7eb" }}>
            <h2 style={{ fontSize: 16, fontWeight: 800, margin: "0 0 12px" }}>Round 1 决策回顾</h2>
            <div style={{ padding: "14px 18px", borderRadius: 12, background: "linear-gradient(135deg,#065f46,#14532d)", color: "#fff", marginBottom: 14 }}>
              <div style={{ fontSize: 10, opacity: 0.7 }}>最终定位 (final_grid_id)</div>
              <div style={{ fontSize: 20, fontWeight: 800, marginTop: 2 }}>{recap?.final_grid_id || "ToB_Differentiation_Elder_Experience"}</div>
              <div style={{ fontSize: 11, opacity: 0.85, marginTop: 6, lineHeight: 1.5 }}>VP: {recap?.vp_summary || "加载中..."}</div>
            </div>
            <div style={{ padding: "12px 16px", borderRadius: 10, background: "#F0FDF4", border: "1.5px solid #BBF7D0", marginBottom: 8 }}>
              <div style={{ fontSize: 10, color: "#6b7280" }}>利润空间（Margin Headroom）</div>
              <div style={{ fontSize: 22, fontWeight: 800, color: "#166534" }}>{recap?.margin_headroom || "中等"} · target_gm {(Number(recap?.target_gm || 0) * 100).toFixed(1)}%</div>
            </div>
            <div style={{ padding: "12px 16px", borderRadius: 10, background: "#EFF6FF", border: "1.5px solid #BFDBFE", marginBottom: 8 }}>
              <div style={{ fontSize: 10, color: "#6b7280" }}>Market Space（市场空间）</div>
              <div style={{ fontSize: 22, fontWeight: 800, color: "#1E40AF" }}>{recap?.market_space_tier || "M"} ｜ 难度 {recap?.difficulty_tier || "中"}</div>
            </div>
            <div style={{ padding: "12px 16px", borderRadius: 10, background: "#F9FAFB", border: "1px solid #e5e7eb", marginBottom: 8 }}>
              <div style={{ fontSize: 12, fontWeight: 700, marginBottom: 6 }}>VP 战略评估</div>
              <div style={{ display: "flex", gap: 14 }}>
                {[["覆盖率(C)", recap?.vp_scores?.C || 0], ["可泛化率(G)", recap?.vp_scores?.G || 0], ["有效性(E)", recap?.vp_scores?.E || 0]].map(([label, score]) => (
                  <div key={label}>
                    <div style={{ fontSize: 10, color: "#6b7280", marginBottom: 3 }}>{label}</div>
                    <div style={{ display: "flex", gap: 2 }}>{[1, 2, 3, 4, 5].map((i) => <div key={i} style={{ width: 16, height: 8, borderRadius: 2, background: i <= score ? "#1a5c3a" : "#e5e7eb" }} />)}</div>
                  </div>
                ))}
              </div>
            </div>
            <div style={{ padding: "12px 16px", borderRadius: 10, background: "#F0FDF4", border: "1.5px solid #BBF7D0", marginBottom: 10 }}>
              <div style={{ fontSize: 12, fontWeight: 700, color: "#166534", marginBottom: 6 }}>锦囊激活</div>
              {recap?.jinang_market && <div style={{ fontSize: 11, marginBottom: 4 }}><b>{recap.jinang_market.name}</b>：契合度 {(Number(recap.jinang_market.match_strength || 0) * 100).toFixed(0)}%</div>}
              {recap?.jinang_tech && <div style={{ fontSize: 11 }}><b>{recap.jinang_tech.name}</b>：契合度 {(Number(recap.jinang_tech.match_strength || 0) * 100).toFixed(0)}%（Round 2 生效）</div>}
              <div style={{ fontSize: 11, color: "#6b7280", marginTop: 4 }}>渠道结构：{recap?.channel_desc || "DIRECT 60% / ECOMMERCE 40%"}</div>
            </div>
            <div style={{ display: "grid", gridTemplateColumns: "repeat(6,1fr)", gap: 6, marginBottom: 10 }}>
              {[["target_gm", `${(Number(recap?.target_gm || 0) * 100).toFixed(1)}%`, "#2FAB6E"], ["WTP", Number(recap?.WTP || recap?.Pmax || 14200).toLocaleString(), "#0EA5E9"], ["e", Number(recap?.e || 1.2).toFixed(2), "#4F46E5"], ["Pmax", Number(recap?.Pmax || 14200).toLocaleString(), "#3B82C4"], ["COGSbase", Number(recap?.COGSbase || 4200).toLocaleString(), "#D4A03C"], ["渠道费率", `${(Number(recap?.f || 0.124) * 100).toFixed(1)}%`, "#8B5CF6"]].map(([label, val, clr]) => (
                <div key={label} style={{ padding: 8, borderRadius: 8, border: `1.5px solid ${clr}40`, background: `${clr}08` }}>
                  <div style={{ fontSize: 9, color: "#6b7280" }}>{label}</div>
                  <div style={{ fontSize: 18, fontWeight: 800, color: clr }}>{val}</div>
                </div>
              ))}
            </div>
            <div style={{ padding: "8px 12px", borderRadius: 8, background: "#FEF3C7", border: "1px solid #FDE68A", fontSize: 11, color: "#92400E" }}>
              R&D 研发基准 = <b>{rdBenchmark}元</b>（超出基准将降低毛利率）
            </div>
            <div style={{ marginTop: 12, padding: "14px 18px", borderRadius: 12, background: "#1e293b", color: "#fff", textAlign: "center" }}>
              <div style={{ fontSize: 14, fontWeight: 700 }}>Round 1 完成 · target_gm 已冻结</div>
              <button onClick={() => setStep(1)} style={{ marginTop: 10, padding: "8px 28px", borderRadius: 8, background: "#fff", color: "#1e293b", border: "none", fontSize: 14, fontWeight: 700, cursor: "pointer" }}>进入 Round 2 →</button>
            </div>
          </div>
        )}

        {step === 1 && (
          <div style={{ background: "#fff", borderRadius: 14, padding: 20, border: "1px solid #e5e7eb" }}>
            <h2 style={{ fontSize: 16, fontWeight: 800, margin: "0 0 10px" }}>维度分配</h2>
            {isSingleTeam && (
              <div style={{ marginBottom: 8, padding: "8px 10px", borderRadius: 8, background: "#F0FDF4", border: "1px solid #BBF7D0", fontSize: 12, color: "#166534" }}>
                单人模式：你负责全部 6 个维度
              </div>
            )}
            {assignments.map((a, i) => (
              <div key={a.memberId || i} onClick={() => setAm(i)} style={{
                display: "flex", alignItems: "center", gap: 6, padding: "8px 10px", borderRadius: 8, marginBottom: 4, cursor: "pointer",
                background: am === i ? `${MC[i % MC.length]}10` : "#fafafa", border: am === i ? `2px solid ${MC[i % MC.length]}60` : "1px solid #f3f4f6"
              }}>
                <div style={{ width: 20, height: 20, borderRadius: "50%", background: MC[i % MC.length], color: "#fff", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 9, fontWeight: 700 }}>{String.fromCharCode(65 + i)}</div>
                <span style={{ fontSize: 12, fontWeight: 600, minWidth: 70 }}>{a.memberName}</span>
                <div style={{ display: "flex", gap: 3, flex: 1 }}>
                  {(a.dims || []).map((d) => {
                    const dm = DIMS.find((x) => x.id === d);
                    if (!dm) return null;
                    return <span key={d} style={{ fontSize: 10, fontWeight: 600, padding: "2px 5px", borderRadius: 4, background: `${dm.c}15`, color: dm.c }}>{dm.icon} {dm.l.slice(0, 2)}</span>;
                  })}
                </div>
                <span style={{ fontSize: 10, color: "#9ca3af" }}>{a.personas}</span>
              </div>
            ))}
            <button onClick={() => setStep(2)} style={BS}>以 {myA.memberName || MN[am]} 身份进入</button>
          </div>
        )}

        {step === 2 && (
          <div style={{ background: "#fff", borderRadius: 14, padding: 20, border: "1px solid #e5e7eb" }}>
            <h2 style={{ fontSize: 16, fontWeight: 800, margin: "0 0 8px" }}>焦点小组访谈</h2>
            {!interviewData && (
              <button onClick={runInterviewAuto} disabled={busy} style={BS}>{busy ? "生成中..." : "生成访谈记录（自动）"}</button>
            )}
            {interviewData && (
              <>
                <div style={{ border: "1.5px solid #e5e7eb", borderRadius: 10, marginBottom: 12 }}>
                  {(interviewData.transcript || []).map((m, i) => (
                    <div key={i} style={{ padding: "8px 12px", borderBottom: i < interviewData.transcript.length - 1 ? "1px solid #f3f4f6" : "none" }}>
                      <span style={{ fontSize: 11, fontWeight: 700, color: m.role === "assistant" ? "#2FAB6E" : "#9CA3AF" }}>{m.speaker}</span>
                      <div style={{ fontSize: 12, color: "#374151", marginTop: 2, lineHeight: 1.5 }}>{m.text}</div>
                    </div>
                  ))}
                </div>
                <RadarChart
                  scores={{
                    perception: interviewData.radar?.perception,
                    motion: interviewData.radar?.mobility,
                    interaction: interviewData.radar?.interaction,
                    safety: interviewData.radar?.safety_privacy,
                    extend: interviewData.radar?.integration,
                    ops: interviewData.radar?.operations
                  }}
                  memberDims={myA.dims || []}
                />
                <div style={{ padding: "6px 10px", borderRadius: 6, background: "#F0FDF4", border: "1px solid #BBF7D0", fontSize: 11, color: "#166534", marginBottom: 8 }}>
                  访谈完成。evi={Number(interviewData.evi || 0).toFixed(2)}，标签：{(interviewData.tags || []).map((t) => t.tag).join("、")}
                </div>
                <div style={{ fontSize: 11, color: "#475569", marginBottom: 6 }}>
                  雷达：感知 {interviewData.radar?.perception} / 运动 {interviewData.radar?.mobility} / 交互 {interviewData.radar?.interaction} / 安全 {interviewData.radar?.safety_privacy} / 连接 {interviewData.radar?.integration} / 运维 {interviewData.radar?.operations}
                </div>
                <button onClick={() => setStep(3)} style={BS}>开始选卡</button>
              </>
            )}
          </div>
        )}

        {step === 3 && (
          <div>
            <div style={{ background: "#fff", padding: "12px 16px", borderRadius: "14px 14px 0 0", border: "1px solid #e5e7eb", borderBottom: "none" }}>
              <h2 style={{ fontSize: 16, fontWeight: 800, margin: "0 0 4px" }}>个人选卡（{myA.memberName || MN[am]}）</h2>
              <div style={{ fontSize: 11, color: "#9ca3af" }}>仅显示当前成员负责维度。每次变更都会调用 validate/calculate API。</div>
            </div>
            <div style={{ background: "#fff", padding: "6px 16px 10px", border: "1px solid #e5e7eb", borderTop: "none", borderRadius: "0 0 14px 14px" }}>
              {renderMetrics(tot, liveViolations, preview)}
            </div>
            {renderPricePanel()}
            {(myA.dims || []).map((dimId) => renderDimGroup(dimId, sel, true))}
            <button onClick={() => setStep(isSingleTeam ? 5 : 4)} style={BS}>{isSingleTeam ? "进入集体讨论" : "提交个人方案"}</button>
          </div>
        )}

        {step === 4 && (
          <div style={{ background: "#fff", borderRadius: 14, padding: 20, border: "1px solid #e5e7eb" }}>
            <h2 style={{ fontSize: 16, fontWeight: 800, margin: "0 0 6px" }}>团队合并 - 预算影响</h2>
            <button onClick={runMerge} disabled={busy} style={{ ...BS, marginTop: 0 }}>{busy ? "合并中..." : "从后端合并成员选卡"}</button>
            <div style={{ marginTop: 8 }}>{renderMetrics(tTot, liveViolations, preview)}</div>
            {DIMS.map((dim) => {
              const cards = cardsByDim[dim.id] || [];
              const picked = cards.filter((c) => !!teamSel[c.id]);
              if (picked.length === 0) return <div key={dim.id} style={{ fontSize: 11, color: "#aaa", padding: "4px 0" }}>{dim.icon} {dim.l}: none</div>;
              return (
                <div key={dim.id} style={{ marginBottom: 6, padding: "6px 10px", borderRadius: 8, background: `${dim.c}06`, border: `1px solid ${dim.c}20` }}>
                  <div style={{ fontSize: 12, fontWeight: 700, color: dim.c, marginBottom: 4 }}>{dim.icon} {dim.l}</div>
                  {picked.map((card) => (
                    <div key={card.id} style={{ display: "flex", alignItems: "center", gap: 6, fontSize: 11, padding: "2px 0" }}>
                      <span style={{ flex: 1 }}>{card.n}</span>
                      <span style={{ fontSize: 10, padding: "1px 5px", borderRadius: 3, background: "#f3f4f6" }}>{teamSel[card.id]}</span>
                      <span style={{ color: "#6b7280" }}>{(selectedBy[card.id] || []).join("、")}</span>
                    </div>
                  ))}
                </div>
              );
            })}
            <button onClick={() => setStep(5)} style={{ ...BS, background: "#DC2626" }}>进入集体讨论</button>
          </div>
        )}

        {step === 5 && (
          <div>
            <div style={{ background: "#fff", borderRadius: 14, padding: "16px 20px", border: "1px solid #e5e7eb", marginBottom: 4 }}>
              <h2 style={{ fontSize: 16, fontWeight: 800, margin: "0 0 6px" }}>集体讨论</h2>
              <div style={{ fontSize: 11, color: "#9ca3af", marginBottom: 8 }}>每次改卡都会调用后端 validate + calculate，实时更新预算和结果</div>
              {renderMetrics(tTot, liveViolations, finalResult || preview)}
              {renderPricePanel()}
              {preview && (
                <div style={{ fontSize: 11, color: "#334155" }}>
                  预估：share {(Number(preview.share || 0) * 100).toFixed(1)}% ｜ units {Number(preview.units || 0).toLocaleString()} ｜ profit {Number(preview.profit || 0).toLocaleString()}
                </div>
              )}
            </div>
            {DIMS.map((dim) => renderDimGroup(dim.id, teamSel, false))}
            <button
              onClick={finalizeRound2}
              disabled={liveHardCount > 0 || tTot.cnt < 8 || tTot.cnt > 10}
              style={{ ...BS, background: (liveHardCount === 0 && tTot.cnt >= 8 && tTot.cnt <= 10) ? "#1a5c3a" : "#d1d5db" }}
            >
              {liveHardCount > 0 ? `存在 ${liveHardCount} 条硬违规` : tTot.cnt < 8 ? `还需 ${8 - tTot.cnt} 张` : tTot.cnt > 10 ? `超出 ${tTot.cnt - 10} 张` : "确认提交"}
            </button>
          </div>
        )}

        {step === 6 && (
          <div style={{ background: "#fff", borderRadius: 14, padding: 20, border: "1px solid #e5e7eb" }}>
            <h2 style={{ fontSize: 16, fontWeight: 800, margin: "0 0 12px" }}>Round 2 最终结果</h2>
            <div style={{ display: "grid", gridTemplateColumns: "repeat(3,1fr)", gap: 8, marginBottom: 12 }}>
              {[["ROI", result.roi == null ? "—" : Number(result.roi).toFixed(2), "#2FAB6E"], ["总利润", Number(result.profit || 0).toLocaleString(), "#1a5c3a"], ["销量", Number(result.units || 0).toLocaleString(), "#3B82C4"]].map(([label, val, clr]) => (
                <div key={label} style={{ padding: 10, borderRadius: 10, border: `1.5px solid ${clr}30`, background: `${clr}08` }}>
                  <div style={{ fontSize: 9, color: "#6b7280" }}>{label}</div>
                  <div style={{ fontSize: 20, fontWeight: 800, color: clr }}>{val}</div>
                </div>
              ))}
            </div>
            <div style={{ padding: "10px 12px", borderRadius: 10, border: "1px solid #e5e7eb", marginBottom: 12, fontSize: 11, color: "#334155", lineHeight: 1.7 }}>
              利润分解：售价收入 → -渠道费 → -成本 → -R&D增量 → 硬件利润（{Number(result.profitHW || 0).toLocaleString()}） → +订阅（{Number(result.profitSub || 0).toLocaleString()}） → -Penalty（-{Number(result.penalty || 0).toLocaleString()}） → 总利润（{Number(result.profit || 0).toLocaleString()}） ｜ R&D投入（{Number(result.rdInvestment || 0).toLocaleString()}）
            </div>
            <div style={{ padding: "14px 18px", borderRadius: 12, background: "#1e293b", color: "#fff" }}>
              <div style={{ fontSize: 14, fontWeight: 700 }}>Round 2 Complete</div>
              <div style={{ fontSize: 11, opacity: 0.8, marginTop: 4, whiteSpace: "pre-wrap" }}>{reflection || "AI reflection report generating..."}</div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
